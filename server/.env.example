# ── Stripe ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret (Dashboard → Developers → Webhooks, or `stripe listen`).
# Required to fulfil asynchronous payments (Multibanco / MB WAY).
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: pin the methods shown at Checkout (comma-separated: card,multibanco,mb_way).
# Leave UNSET to use Dynamic Payment Methods — Stripe shows every method enabled
# in the Dashboard (card + Apple/Google Pay + Multibanco/MB WAY), adapted to the buyer.
# STRIPE_PAYMENT_METHODS=card,multibanco

# ── App ──────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
PORT=3001
# Beta gate. While not 'false', PDF generation is fully disabled (checkout,
# paywall and email refuse). Defaults to ON. Set to false at go-live.
BETA_MODE=true

# ── Email (Resend) ───────────────────────────────────────
# RESEND_API_KEY=re_...
# RESEND_FROM=CVeaver <no-reply@cveaver.com>
