# OpenCV starts locally without an .env file or external services.
PORT=3001
HOST=127.0.0.1
CLIENT_URL=http://localhost:5173
PDF_CONCURRENCY=2
# Optional: Vite proxies /api in development; production serves /api directly.
VITE_API_URL=/api
# Set to 1 only behind a single trusted reverse proxy.
# TRUST_PROXY=1

# Public browser URL (exact scheme + host + port); required for SSO redirects and CSRF checks.
# For Docker, use http://localhost:8080 or your public HTTPS URL instead.
APP_URL=http://localhost:5173
# Optional local SQLite location; Docker uses /app/data/opencv.sqlite in a named volume.
# DATABASE_PATH=/absolute/path/to/opencv.sqlite

# Configure SSO in Administration. These optional variables bootstrap it only
# when no SSO settings exist in the database. Later changes belong in the UI.
# Redirect URI: <APP_URL>/api/auth/sso/callback
# Scopes: openid profile email. Authorization code flow with PKCE (S256).
# OIDC_ISSUER=https://identity.example.com/application/o/opencv/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_LABEL=Company SSO
# Allow HTTP discovery ONLY for local development (never production).
# OIDC_ALLOW_HTTP=false
