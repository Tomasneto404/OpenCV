# ─────────────────────────────────────────────────────────────────────────────
# CVeaver — production env template
# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env` (gitignored) and fill the values. The compose file fails fast
# on missing critical vars (DOMAIN, ACME_EMAIL, STRIPE_SECRET_KEY).
# ─────────────────────────────────────────────────────────────────────────────

# ── Domain & TLS ────────────────────────────────────────────────────────────
# The bare domain (no scheme, no trailing slash).
# Traefik will serve:   https://${DOMAIN}           → client
#                       https://api.${DOMAIN}       → server
#                       https://traefik.${DOMAIN}   → dashboard (basic-auth)
DOMAIN=cveaver.com

# Email used by Let's Encrypt to send expiry warnings.
ACME_EMAIL=admin@cveaver.com

# Traefik dashboard basic-auth. Generate with:
#   htpasswd -nb admin yourpassword | sed 's/\$/\$\$/g'
# Leave empty to disable the dashboard router.
TRAEFIK_DASHBOARD_AUTH=

# ── Stripe ──────────────────────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
# Use sk_live_... + pk_live_... in production.
STRIPE_SECRET_KEY=sk_live_replace_me
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_replace_me

# Webhook signing secret. REQUIRED to fulfil asynchronous payments
# (Multibanco / MB WAY): the webhook renders + emails the PDF when the payment
# confirms. Create the endpoint at https://api.${DOMAIN}/webhook/stripe in the
# Stripe Dashboard (events: checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed)
# and paste its whsec_... here.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Comma-separated payment methods to pin at Checkout (e.g. card,multibanco,mb_way).
# Leave EMPTY to use Dynamic Payment Methods — Stripe shows everything enabled in
# the Dashboard (card + Apple/Google Pay + Multibanco/MB WAY), adapted to the buyer.
STRIPE_PAYMENT_METHODS=

# ── Email delivery (Resend) ─────────────────────────────────────────────────
# https://resend.com/api-keys
# When RESEND_API_KEY is empty the paywall still works but no email is sent.
# RESEND_FROM must use a domain verified in the Resend dashboard (DKIM/DMARC).
RESEND_API_KEY=re_replace_me
RESEND_FROM=CVeaver <no-reply@cveaver.com>

# Optional override for the logo image rendered in the email header.
# Defaults to https://${DOMAIN}/logo.png — set this if you host the logo
# elsewhere (e.g. a CDN) or while the domain isn't live yet.
# LOGO_URL=https://cveaver.com/logo.png

# ── Server tuning ───────────────────────────────────────────────────────────
# Max concurrent PDF renders (back-pressure for CPU / memory).
PDF_CONCURRENCY=4

# ── Optional: payload AES key override ──────────────────────────────────────
# By default the server generates and persists this key on first boot inside
# the cveaver-keys volume. Set this only if you need a fixed key across
# replicas (multi-instance deploy) or external secret management.
# Must be 32 raw bytes, base64-encoded. Generate with:
#   openssl rand -base64 32
PAYLOAD_AES_KEY_B64=
