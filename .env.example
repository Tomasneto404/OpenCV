# ── Stripe ─────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── URLs ────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:3001

# ── Stripe payment methods (PT) ─────────────────────
# Comma-separated: card,multibanco,mb_way
# MB WAY requires activation on your Stripe account (live mode).
STRIPE_PAYMENT_METHODS=card,multibanco
