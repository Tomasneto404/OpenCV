# OpenCV starts locally without an .env file or external services.
PORT=3001
HOST=127.0.0.1
CLIENT_URL=http://localhost:5173
PDF_CONCURRENCY=2
# Optional: /api uses the Vite or nginx same-origin proxy.
VITE_API_URL=/api
# Persistent keys are generated automatically in server/keys.
# SIGN_KEY_DIR=/absolute/path/to/keys
# PAYLOAD_AES_KEY_B64=
# Set to 1 only behind a single trusted reverse proxy.
# TRUST_PROXY=1
